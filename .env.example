# Next.js Environment Variables
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Firebase Configuration
# Získejte tyto hodnoty z Firebase Console:
# 1. Jděte na https://console.firebase.google.com/
# 2. Vyberte váš projekt (nebo vytvořte nový)
# 3. Jděte do Project Settings (ikona ozubeného kola) > General
# 4. Scrollujte dolů na "Your apps" a klikněte na Web app (</> ikona)
# 5. Zkopírujte hodnoty z firebaseConfig objektu

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Admin Authentication
# Změňte na silné heslo!
ADMIN_PASSWORD=admin123

